GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=
# Optional second model — used only when AI_MODEL_RACE_ENABLED=true (parallel race, first success wins).
GEMINI_MODEL_FALLBACK=
AI_MODEL_RACE_ENABLED=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

# Enable request signing by setting a shared secret (best-effort anti-abuse).
# Client: pass the same value via `--dart-define=API_SIGNING_SECRET=...`
API_SIGNING_SECRET=
# Allowed client/server clock skew and nonce replay window.
API_SIGNING_MAX_SKEW_SECONDS=120

